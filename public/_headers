# Security headers for Cloudflare Pages (and Netlify), which read this file.
# GitHub Pages ignores it; there, the CSP <meta> tag added at build time still
# applies, but frame-ancestors and the other headers below cannot be set.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'none'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
